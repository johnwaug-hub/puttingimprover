{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "🎯 Putting Improver",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Accent"
        },
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${points}",
                  "size": "ExtraLarge",
                  "weight": "Bolder",
                  "color": "Good"
                },
                {
                  "type": "TextBlock",
                  "text": "Total Points",
                  "size": "Small",
                  "isSubtle": true
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${accuracy}%",
                  "size": "ExtraLarge",
                  "weight": "Bolder",
                  "color": "Accent"
                },
                {
                  "type": "TextBlock",
                  "text": "Accuracy",
                  "size": "Small",
                  "isSubtle": true
                }
              ]
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "${sessions} Sessions",
          "size": "Small",
          "spacing": "Medium"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Start Practice",
      "url": "/?action=practice"
    },
    {
      "type": "Action.OpenUrl",
      "title": "View Stats",
      "url": "/?action=stats"
    }
  ]
}
